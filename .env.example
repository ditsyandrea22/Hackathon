# AgentRouter OpenAI-compatible API (base URL includes /v1)
OPENAI_BASE_URL=
OPENAI_API_KEY=
MODEL=deepseek-v4-flash

# Stripe: restricted TEST key only (rk_test_... or sk_test_...). Live keys are rejected.
STRIPE_TEST_KEY=

# Sandbox: "local" (dev only, NOT isolated) or "createos"
SANDBOX=local
CREATEOS_API_KEY=
CREATEOS_API_BASE=

PORT=8080
